@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tư vấn trực tuyến - Dược sĩ MedCare</title>
    <link rel="stylesheet" href="~/css/main.css">
    <link rel="stylesheet" href="~/css/pharmacy.css">
</head>
<body>
    <div class="dash-layout">
        <aside class="dash-sidebar">
            <a class="brand" asp-controller="Pharmacist" asp-action="Index">
                <span>✚</span> MedCare
            </a>
            <div class="side-sep">Nghiệp vụ Dược sĩ</div>
            <nav>
                <a asp-controller="Pharmacist" asp-action="Index">📊 Tổng quan</a>
                <a asp-controller="Pharmacist" asp-action="Pos">💵 Bán tại quầy POS</a>
                <a asp-controller="Pharmacist" asp-action="OnlineOrders">📦 Đơn online</a>
                <a asp-controller="Pharmacist" asp-action="InventoryAlert">⚠️ Cảnh báo kho</a>
                <a class="active" asp-controller="Pharmacist" asp-action="Consultation">💬 Tư vấn trực tuyến</a>
            </nav>
            <div class="side-sep">Liên kết</div>
            <nav>
                <a asp-controller="Home" asp-action="Index">🏠 Trang chủ khách hàng</a>
                <a asp-controller="Admin" asp-action="Index">🛡️ Khu vực Admin</a>
            </nav>
        </aside>

        <main class="dash-main">
            <div class="dash-header">
                <div>
                    <div class="breadcrumb">Dược sĩ / Tư vấn trực tuyến</div>
                    <h1>Tư vấn trực tuyến</h1>
                </div>
                <div style="display:flex;gap:8px;align-items:center">
                    <span id="authArea"></span>
                </div>
            </div>

            <!-- Chỉ MỘT dropdown — JS (initPharmacistChat) chỉ hiện khi role = admin -->
            <div style="margin-bottom:12px">
                <label for="chatPharmacistFilter" style="font-weight:600;margin-right:8px">Xem theo dược sĩ (Admin):</label>
                <select id="chatPharmacistFilter"
                        style="display:none;min-width:260px;padding:8px 12px;border-radius:8px;border:1px solid #d1d5db">
                    <option value="">— Tất cả dược sĩ —</option>
                </select>
            </div>

            <div class="chat-layout pharmacist-chat" id="chatRoot">
                <aside class="chat-conv-list">
                    <div class="chat-conv-head">💬 Hội thoại</div>
                    <div id="chatConvList" class="chat-conv-body"></div>
                </aside>

                <section class="chat-panel">
                    <div class="chat-header">
                        <div class="chat-peer" id="chatHeader">Chọn một cuộc trò chuyện</div>
                    </div>

                    <div class="chat-messages" id="chatMessages"></div>

                    <div class="chat-input-bar">
                        <input type="file" id="chatImage" accept="image/jpeg,image/png,image/webp,image/gif" style="display:none">
                        <label for="chatImage" id="chatImageBtn" class="btn muted" title="Gửi ảnh"
                               style="flex-shrink:0;padding:8px 12px;cursor:pointer;margin:0;display:inline-flex;align-items:center">
                            📷
                        </label>
                        <div style="flex:1;display:flex;flex-direction:column;gap:6px;min-width:0">
                            <img id="chatImagePreview" alt="Xem trước"
                                 style="display:none;max-height:80px;max-width:160px;border-radius:8px;object-fit:contain">
                            <textarea id="chatInput" rows="1" placeholder="Nhập câu trả lời... (Enter để gửi)"></textarea>
                        </div>
                        <button type="button" id="chatSend" class="primary-btn">Gửi ➤</button>
                    </div>
                </section>
            </div>
        </main>
    </div>

    <div id="toast" class="toast"></div>

    <script src="~/js/api.js"></script>
    <script src="~/js/main.js"></script>
    <script src="~/js/auth.js"></script>
    <script src="~/js/pharmacy.js"></script>
    <script src="~/js/chat.js"></script>
    <script>
            document.addEventListener("DOMContentLoaded", () => {
                if (typeof requireRoleAny === "function") {
                    requireRoleAny(["pharmacist", "admin"]);
                } else if (typeof requireRole === "function") {
                    requireRole("pharmacist");
                }
                if (typeof renderAuthArea === "function") renderAuthArea();
                if (typeof initPharmacistChat === "function") initPharmacistChat();
            });
    </script>
</body>
</html>