@{
    ViewData["Title"] = "Chi tiết Dược sĩ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var pid = ViewData["PharmacistId"];
}

<div class="dash-header" style="margin-bottom:18px">
    <div>
        <div class="breadcrumb">
            <a asp-controller="Admin" asp-action="Pharmacists">Dược sĩ</a> / Chi tiết
        </div>
        <h1 id="detailTitle">Thông tin Dược sĩ</h1>
    </div>
    <a class="btn ghost" asp-controller="Admin" asp-action="Pharmacists">← Danh sách</a>
</div>

<div id="pharmacistDetail" data-id="@pid">
    <div class="empty">Đang tải...</div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            if (typeof requireRole === "function") requireRole("admin");
            if (typeof renderAuthArea === "function") renderAuthArea();
            if (typeof initAdminPharmacistDetail === "function") initAdminPharmacistDetail();
        });
    </script>
}