@{
    ViewData["Title"] = "Danh sách Dược sĩ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="dash-header" style="margin-bottom:18px">
    <div>
        <div class="breadcrumb">Admin / Dược sĩ</div>
        <h1>Danh sách Dược sĩ</h1>
        <p style="color:#6b7280;margin-top:4px">Chọn một dược sĩ để xem thông tin và quản lý.</p>
    </div>
</div>

<div class="panel">
    <div class="panel-title"><span>Tất cả dược sĩ trong hệ thống</span></div>
    <div id="pharmacistList" class="pharmacist-grid" style="max-height:70vh;overflow-y:auto;padding:8px">
        <div class="empty">Đang tải...</div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            if (typeof requireRole === "function") requireRole("admin");
            if (typeof renderAuthArea === "function") renderAuthArea();
            if (typeof initAdminPharmacistList === "function") initAdminPharmacistList();
        });
    </script>
}