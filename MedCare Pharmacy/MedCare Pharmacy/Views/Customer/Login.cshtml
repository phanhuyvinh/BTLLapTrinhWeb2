@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập - MedCare Pharmacy</title>
    <link rel="stylesheet" href="~/css/main.css">
    <link rel="stylesheet" href="~/css/auth.css">
    <style>
            /* Tinh chỉnh CSS riêng cho ô mật khẩu và nút ẩn/hiện */
            .password-container {
                position: relative;
                display: flex;
                align-items: center;
            }

                .password-container input {
                    width: 100%;
                    padding-right: 42px !important; /* Tạo khoảng trống bên phải cho icon */
                }

            .toggle-password {
                position: absolute;
                right: 12px;
                background: none;
                border: none;
                cursor: pointer;
                padding: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #666;
                transition: color 0.2s;
            }

                .toggle-password:hover {
                    color: #0b8f66;
                }
    </style>
</head>
<body class="auth-page">
    <div class="auth-card">
        <a class="auth-logo" asp-controller="Home" asp-action="Index">
            <span>✚</span> MedCare
        </a>

        <div id="loginBlock">
            <h2>Đăng nhập</h2>
            <p class="sub">Chào mừng bạn trở lại MedCare Pharmacy</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 12px; font-size: 13px; color: #d92d20;"></div>

        <div class="role-hint" id="roleHint">
            <b>Tài khoản test:</b><br>
            • Admin: <code>admin@medcare.vn</code> (pass: 123456)<br>
            • Dược sĩ: <code>pharma@medcare.vn</code> (pass: 123456)<br>
            • Khách hàng: Email bất kỳ
        </div>

        <form id="loginForm" onsubmit="handleLoginSubmit(event)" novalidate>
            <div class="form-field">
                <label>Email / Số điện thoại *</label>
                <input name="email"
                       type="text"
                       placeholder="you@example.com"
                       required>
                <span id="emailError" class="text-danger" style="font-size: 12px; color: #d92d20; display: block; margin-top: 4px;"></span>
            </div>

            <div class="form-field">
                <label>Mật khẩu *</label>
                <div class="password-container">
                    <input name="password"
                           id="passwordInput"
                           type="password"
                           placeholder="••••••"
                           required>

                    <!-- Nút bấm ẩn/hiện mật khẩu sử dụng SVG icon gọn gàng và chuyên nghiệp -->
                    <button type="button"
                            id="togglePasswordBtn"
                            class="toggle-password"
                            onclick="togglePasswordVisibility()"
                            title="Hiện/Ẩn mật khẩu">
                        <!-- Icon Mắt Mở (mặc định) -->
                        <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
                <span id="passwordError" class="text-danger" style="font-size: 12px; color: #d92d20; display: block; margin-top: 4px;"></span>
            </div>

            <div class="row-check">
                <label>
                    <input type="checkbox">
                    Ghi nhớ đăng nhập
                </label>

                <a asp-controller="Customer" asp-action="ForgotPassword">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="primary-btn" style="width:100%;margin-top:12px;padding:12px">Đăng nhập</button>
        </form>

        <div class="switch" id="switchBlock">
            Chưa có tài khoản?
            <a asp-controller="Customer" asp-action="Register">
                Đăng ký ngay
            </a>
        </div>

        <a class="back"
           asp-controller="Home"
           asp-action="Index"
           style="margin-top:16px;display:inline-block">
            ← Về trang chủ
        </a>
    </div>

    <div id="toast" class="toast"></div>

    <script src="~/js/api.js"></script>
    <script src="~/js/main.js"></script>
    <script src="~/js/auth.js"></script>

    <script>
            // Hàm xử lý chuyển đổi trạng thái ẩn/hiện mật khẩu và thay đổi SVG icon tương ứng
            function togglePasswordVisibility() {
                const passwordInput = document.getElementById("passwordInput");
                const eyeIcon = document.getElementById("eyeIcon");

                if (passwordInput.type === "password") {
                    passwordInput.type = "text";
                    // Chuyển sang icon Mắt Đóng (khi đang hiển thị mật khẩu)
                    eyeIcon.innerHTML = `
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            `;
                } else {
                    passwordInput.type = "password";
                    // Chuyển lại về icon Mắt Mở (khi đang ẩn mật khẩu)
                    eyeIcon.innerHTML = `
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            `;
                }
            }

            // Do not treat localStorage as an authenticated server session.
            // The browser copy may outlive the HttpOnly PageCookie; automatically
            // redirecting from stale local state can create a login/dashboard loop.
    </script>
</body>
</html>
