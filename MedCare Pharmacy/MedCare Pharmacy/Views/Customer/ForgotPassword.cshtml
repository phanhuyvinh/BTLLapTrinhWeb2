@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quên mật khẩu - MedCare Pharmacy</title>
    <link rel="stylesheet" href="~/css/main.css">
    <link rel="stylesheet" href="~/css/auth.css">
</head>
<body class="auth-page">
    <div class="auth-card">
        <a class="auth-logo" asp-controller="Home" asp-action="Index">
            <span>✚</span> MedCare
        </a>

        <h2>Khôi phục mật khẩu</h2>
        <p class="sub">Nhập email hoặc số điện thoại đã đăng ký để nhận hướng dẫn đặt lại mật khẩu.</p>

        <form id="forgotForm" onsubmit="handleForgotPasswordSubmit(event)">
            <div class="form-field">
                <label>Email hoặc Số điện thoại *</label>
                <input name="emailOrPhone" type="text" placeholder="you@example.com hoặc 09xxxxxxxx" required>
            </div>

            <button type="submit" class="primary-btn" style="width:100%;margin-top:12px;padding:12px">Gửi yêu cầu</button>
        </form>

        <div class="switch">
            Đã nhớ mật khẩu? <a asp-controller="Customer" asp-action="Login">Đăng nhập ngay</a>
        </div>

        <a class="back" asp-controller="Home" asp-action="Index" style="margin-top:16px;display:inline-block">
            ← Về trang chủ
        </a>
    </div>

    <div id="toast" class="toast"></div>

    <script src="~/js/api.js"></script>
    <script src="~/js/main.js"></script>
    <script src="~/js/auth.js"></script>
    <script>
            async function handleForgotPasswordSubmit(e) {
                e.preventDefault();
                const val = e.target.emailOrPhone.value.trim();
                if (!val) {
                    if (typeof showToast === "function") showToast("Vui lòng nhập email hoặc số điện thoại!", "error");
                    else alert("Vui lòng nhập email hoặc số điện thoại!");
                    return;
                }

                if (typeof showToast === "function") showToast("Đang gửi yêu cầu khôi phục...", "info");

                try {
                    // Nếu bạn có API backend, có thể gọi ở đây:
                    // await apiPost('/api/auth/forgot-password', { emailOrPhone: val });

                    setTimeout(() => {
                        if (typeof showToast === "function") {
                            showToast("Yêu cầu thành công! Vui lòng kiểm tra hộp thư để đặt lại mật khẩu.", "success");
                        } else {
                            alert("Yêu cầu thành công! Vui lòng kiểm tra hộp thư.");
                        }
                        e.target.reset();
                    }, 1000);
                } catch (err) {
                    if (typeof showToast === "function") showToast("Có lỗi xảy ra, vui lòng thử lại.", "error");
                }
            }
    </script>
</body>
</html>
