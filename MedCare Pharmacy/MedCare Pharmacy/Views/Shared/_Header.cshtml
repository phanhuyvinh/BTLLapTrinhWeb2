<header class="top-header">
    <div class="top-bar">
        <span>📍 Tìm nhà thuốc</span>
        <a asp-controller="Customer" asp-action="Orders">Tra cứu đơn hàng</a>
        <span>Hotline: 1800 0000</span>
    </div>

    <div class="main-header">
        <a class="logo" asp-controller="Home" asp-action="Index">
            <span>✚</span> MedCare
        </a>

        <form class="search-box" id="searchForm"
              onsubmit="event.preventDefault(); location.href='@Url.Action("Products", "Customer")?q=' + encodeURIComponent(document.getElementById('searchInput').value)">
            <div class="search-suggest-wrap">
                <input id="searchInput" name="q" type="text" autocomplete="off"
                       placeholder="Tìm kiếm thuốc, vitamin, sản phẩm...">
                <div id="searchSuggest" class="search-suggest" role="listbox" aria-label="Gợi ý tìm kiếm"></div>
            </div>
            <button type="submit">🔍</button>
        </form>

        <div class="header-actions">
            <span id="authArea"></span>
            <a asp-controller="Customer" asp-action="Cart" class="link-btn">
                🛒 Giỏ hàng <b id="cartCount">0</b>
            </a>
        </div>
    </div>

    <nav class="nav">
        <a asp-controller="Home" asp-action="Index">Trang chủ</a>
        <a asp-controller="Customer" asp-action="Products" asp-route-cat="7">Thuốc giảm đau</a>
        <a asp-controller="Customer" asp-action="Products" asp-route-cat="5">Vitamin & Khoáng chất</a>
        <a asp-controller="Customer" asp-action="Products" asp-route-cat="3">Chăm sóc da</a>
        <a asp-controller="Customer" asp-action="Products" asp-route-cat="1">Sơ cứu</a>
        <a asp-controller="Customer" asp-action="Products" asp-route-cat="6">Tiêu hóa</a>
        <a asp-controller="Customer" asp-action="Products" asp-route-cat="8">Tai mũi họng</a>
        <a asp-controller="Customer" asp-action="Consultation">💬 Tư vấn trực tuyến</a>
    </nav>
</header>
