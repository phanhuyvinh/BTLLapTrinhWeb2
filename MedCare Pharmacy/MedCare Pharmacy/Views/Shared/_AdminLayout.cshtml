<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - MedCare Admin</title>
    <link rel="stylesheet" href="~/css/main.css">
    <link rel="stylesheet" href="~/css/admin.css">
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="dash-layout">
        <aside class="dash-sidebar">
            <a class="brand" asp-controller="Admin" asp-action="Index">
                <span>✚</span> MedCare
            </a>

            <div class="side-sep">Quản trị</div>

            <nav>
                <a asp-controller="Admin" asp-action="Index">📊 Tổng quan</a>
                <a asp-controller="Admin" asp-action="Medicines">💊 Thuốc</a>
                <a asp-controller="Admin" asp-action="Categories">🗂️ Danh mục</a>
                <a asp-controller="Admin" asp-action="Suppliers">🏭 Nhà cung cấp</a>
                <a asp-controller="Admin" asp-action="NhapKho">📥 Nhập kho</a>
                <a asp-controller="Admin" asp-action="Users">👥 Người dùng</a>
                <a asp-controller="Admin" asp-action="Reports">📈 Báo cáo</a>
            </nav>

            <div class="side-sep">Liên kết</div>

            <nav>
                <a asp-controller="Home" asp-action="Index">🏠 Trang chủ khách hàng</a>
                <a asp-controller="Admin" asp-action="Pharmacists">💼 Khu vực Dược sĩ</a>
            </nav>
        </aside>

        <main class="dash-main">
            @RenderBody()
        </main>
    </div>

    <div id="toast" class="toast"></div>

    <script src="~/js/api.js"></script>
    <script src="~/js/main.js"></script>
    <script src="~/js/auth.js"></script>
    <script src="~/js/admin.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>