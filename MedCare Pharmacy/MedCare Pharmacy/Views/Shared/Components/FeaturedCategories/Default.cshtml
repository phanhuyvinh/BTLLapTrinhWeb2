@model IReadOnlyList<MedCare_Pharmacy.Models.ViewModels.FeaturedCategoryViewModel>

@if (Model.Count == 0)
{
    <p class="category-empty">Danh mục sản phẩm hiện chưa khả dụng.</p>
}
else
{
    foreach (var category in Model)
    {
        <a class="category"
           asp-controller="Customer"
           asp-action="Products"
           asp-route-cat="@category.Id">
            @category.Icon
            <span>@category.Name</span>
        </a>
    }
}
